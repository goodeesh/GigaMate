[Unit]
Description=GigaMate — NVIDIA dGPU undervolt watcher
Documentation=https://github.com/goodeesh/GigaMate
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=%h/.local/bin/gigamate-dgpu-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
