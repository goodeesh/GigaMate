// GigaMate — allow local active users and wheel/sudo to manage nvidia-powerd without password
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "nvidia-powerd.service") {
        if (subject.isInGroup("wheel") || subject.isInGroup("sudo") || subject.active) {
            return polkit.Result.YES;
        }
    }
});
