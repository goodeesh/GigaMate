#!/usr/bin/env python3
"""GigaMate — privileged NVIDIA dGPU tuning helper.

This script is installed root-owned (0755) at /usr/lib/gigamate/gigamate-dgpu-nvml
and invoked via pkexec by the unprivileged GigaMate tray/CLI/Center. It performs
exactly one NVML operation and exits; it never lingers (an open NVML handle would
keep the dGPU awake).

Commands (argv):
    probe                          Report which tuning APIs this GPU/driver supports.
    get                            Read the V/F offset and GPU utilization.
    apply <mhz> [maxmhz] [memmhz]   Set the V/F offset (0..255), optional boost-clock
                                   cap and optional memory-clock pin.
    clear                          Offset 0 + unlock both clocks (stock).

The clock cap uses nvmlDeviceSetGpuLockedClocks(dev, 0, maxmhz), which upper-
bounds the boost clock (0 or omitted = unlocked). The memory clock is pinned with
nvmlDeviceSetMemoryLockedClocks(dev, mhz, mhz); note this can only select a clock
the GPU already supports (it cannot exceed nvmlDeviceGetMaxClockInfo(MEM)), so on
most mobile parts it is a *pin* (guaranteed max) or a *cap*, not a true overclock.

There is deliberately **no live telemetry** here (no temperature, clocks, power or
VRAM): tools such as MangoHud and nvtop already own live metrics, and every NVML
read risks resuming a dGPU the kernel has powered down. GigaMate's job is tuning
the dGPU and leaving it asleep when it is not being used.

Output: a single JSON object on stdout. Exit code 0 on success, 2 on usage error.
"""

import ctypes
import json
import os
import re
import sys
from ctypes import c_char_p, c_int, c_uint, c_void_p, POINTER, Structure

# Bumped whenever the CLI/UI start sending arguments or reading fields that an
# older installed helper would silently ignore. Callers compare this against
# their own expectation so a stale helper is reported instead of half-working.
HELPER_VERSION = 3

MAX_OFFSET_MHZ = 255
MAX_CLOCK_MHZ = 4000
MAX_MEM_CLOCK_MHZ = 32000
NVML_CLOCK_GRAPHICS = 0
NVML_CLOCK_MEM = 2

NVML_SUCCESS = 0
NVML_ERROR_NOT_SUPPORTED = 3
NVML_ERROR_NO_PERMISSION = 4


# ──────────────────────────────────────────────────────────────────────────────
# Device discovery (sysfs; does not wake the GPU)
# ──────────────────────────────────────────────────────────────────────────────

_PCI_DEVICES = "/sys/bus/pci/devices"
_NVIDIA_VENDOR = "0x10de"


def find_nvidia_bdf():
    """Return the PCI BDF (e.g. '0000:64:00.0') of the NVIDIA 3D/VGA controller."""
    try:
        entries = os.listdir(_PCI_DEVICES)
    except OSError:
        return None
    for name in sorted(entries):
        dev = os.path.join(_PCI_DEVICES, name)
        try:
            with open(os.path.join(dev, "vendor")) as fh:
                vendor = fh.read().strip()
            with open(os.path.join(dev, "class")) as fh:
                klass = fh.read().strip()
        except OSError:
            continue
        if vendor != _NVIDIA_VENDOR:
            continue
        # 0x0300xx = VGA controller, 0x0302xx = 3D controller
        if not (klass.startswith("0x0300") or klass.startswith("0x0302")):
            continue
        # BDF as NVML expects it.
        if re.fullmatch(r"[0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-9a-fA-F]",
                        name):
            return name
    return None


# ──────────────────────────────────────────────────────────────────────────────
# NVML backends
# ──────────────────────────────────────────────────────────────────────────────

class _NvmlUtilization(Structure):
    _fields_ = [("gpu", c_uint), ("memory", c_uint)]


# Optional NVML entry points. Absent on older drivers and on GPUs that do not
# implement the feature, so they are bound defensively and a missing symbol (or a
# failing call) is reported as "unavailable" rather than crashing the helper.
_OPTIONAL_SIGNATURES = (
    ("nvmlDeviceGetSupportedMemoryClocks", [c_void_p, POINTER(c_uint), POINTER(c_uint)]),
    ("nvmlDeviceSetMemoryLockedClocks", [c_void_p, c_uint, c_uint]),
    ("nvmlDeviceResetMemoryLockedClocks", [c_void_p]),
)


class NvmlError(Exception):
    def __init__(self, message, code=None):
        super().__init__(message)
        self.code = code


class _CtypesBackend:
    """Minimal ctypes binding to libnvidia-ml.so (stdlib only)."""

    def __init__(self):
        lib = None
        for soname in ("libnvidia-ml.so.1", "libnvidia-ml.so"):
            try:
                lib = ctypes.CDLL(soname)
                break
            except OSError:
                continue
        if lib is None:
            raise NvmlError("libnvidia-ml.so not found")
        self._lib = lib
        self._init = getattr(lib, "nvmlInit_v2", None) or getattr(lib, "nvmlInit", None)
        if self._init is None:
            raise NvmlError("nvmlInit symbol missing")
        lib.nvmlShutdown.restype = c_int
        lib.nvmlErrorString.argtypes = [c_int]
        lib.nvmlErrorString.restype = c_char_p
        lib.nvmlDeviceGetHandleByPciBusId_v2.argtypes = [c_char_p, POINTER(c_void_p)]
        lib.nvmlDeviceGetHandleByPciBusId_v2.restype = c_int
        lib.nvmlDeviceSetGpcClkVfOffset.argtypes = [c_void_p, c_int]
        lib.nvmlDeviceSetGpcClkVfOffset.restype = c_int
        lib.nvmlDeviceGetGpcClkVfOffset.argtypes = [c_void_p, POINTER(c_int)]
        lib.nvmlDeviceGetGpcClkVfOffset.restype = c_int
        lib.nvmlDeviceGetUtilizationRates.argtypes = [c_void_p, POINTER(_NvmlUtilization)]
        lib.nvmlDeviceGetUtilizationRates.restype = c_int
        if hasattr(lib, "nvmlDeviceSetGpuLockedClocks"):
            lib.nvmlDeviceSetGpuLockedClocks.argtypes = [c_void_p, c_uint, c_uint]
            lib.nvmlDeviceSetGpuLockedClocks.restype = c_int
        if hasattr(lib, "nvmlDeviceResetGpuLockedClocks"):
            lib.nvmlDeviceResetGpuLockedClocks.argtypes = [c_void_p]
            lib.nvmlDeviceResetGpuLockedClocks.restype = c_int
        if hasattr(lib, "nvmlDeviceGetMaxClockInfo"):
            lib.nvmlDeviceGetMaxClockInfo.argtypes = [c_void_p, c_uint, POINTER(c_uint)]
            lib.nvmlDeviceGetMaxClockInfo.restype = c_int
        for name, argtypes in _OPTIONAL_SIGNATURES:
            fn = getattr(lib, name, None)
            if fn is not None:
                fn.argtypes = argtypes
                fn.restype = c_int
        self._handle = None

    def _err(self, ret):
        try:
            text = self._lib.nvmlErrorString(ret)
            text = text.decode("utf-8", "replace") if text else f"NVML error {ret}"
        except Exception:
            text = f"NVML error {ret}"
        return NvmlError(text, code=ret)

    def _check(self, ret):
        if ret != NVML_SUCCESS:
            raise self._err(ret)

    def open(self, bdf):
        self._check(self._init())
        handle = c_void_p()
        self._check(self._lib.nvmlDeviceGetHandleByPciBusId_v2(bdf.encode(), ctypes.byref(handle)))
        self._handle = handle
        return self

    def close(self):
        try:
            self._lib.nvmlShutdown()
        except Exception:
            pass

    def get_offset(self):
        out = c_int(0)
        self._check(self._lib.nvmlDeviceGetGpcClkVfOffset(self._handle, ctypes.byref(out)))
        return int(out.value)

    def set_offset(self, mhz):
        self._check(self._lib.nvmlDeviceSetGpcClkVfOffset(self._handle, c_int(int(mhz))))

    def get_util(self):
        u = _NvmlUtilization()
        self._check(self._lib.nvmlDeviceGetUtilizationRates(self._handle, ctypes.byref(u)))
        return int(u.gpu)

    def set_max_clock(self, mhz):
        """Upper-bound the graphics clock to `mhz` (0 < mhz <= ceiling)."""
        fn = getattr(self._lib, "nvmlDeviceSetGpuLockedClocks", None)
        if fn is None:
            raise NvmlError("locked clocks unsupported", NVML_ERROR_NOT_SUPPORTED)
        self._check(fn(self._handle, c_uint(0), c_uint(int(mhz))))

    def reset_max_clock(self):
        fn = getattr(self._lib, "nvmlDeviceResetGpuLockedClocks", None)
        if fn is None:
            raise NvmlError("locked clocks unsupported", NVML_ERROR_NOT_SUPPORTED)
        self._check(fn(self._handle))

    def get_max_clock(self, clock_id=NVML_CLOCK_GRAPHICS):
        fn = getattr(self._lib, "nvmlDeviceGetMaxClockInfo", None)
        if fn is None:
            raise NvmlError("max clock info unsupported", NVML_ERROR_NOT_SUPPORTED)
        out = c_uint(0)
        self._check(fn(self._handle, c_uint(clock_id), ctypes.byref(out)))
        return int(out.value)

    def get_mem_clocks(self):
        """The memory clocks this GPU supports (ascending, MHz)."""
        fn = getattr(self._lib, "nvmlDeviceGetSupportedMemoryClocks", None)
        if fn is None:
            raise NvmlError("supported memory clocks unsupported", NVML_ERROR_NOT_SUPPORTED)
        # A NULL buffer is rejected with INSUFFICIENT_SIZE on some drivers but
        # still reports the count, so the first return value is intentionally
        # ignored here.
        count = c_uint(0)
        fn(self._handle, ctypes.byref(count), None)
        if not 0 < count.value < 4096:
            raise NvmlError("supported memory clocks unavailable", NVML_ERROR_NOT_SUPPORTED)
        buf = (c_uint * count.value)()
        self._check(fn(self._handle, ctypes.byref(count), buf))
        return sorted({int(v) for v in buf if v})

    def set_mem_clock(self, mhz):
        """Pin the memory clock at `mhz` (min == max)."""
        fn = getattr(self._lib, "nvmlDeviceSetMemoryLockedClocks", None)
        if fn is None:
            raise NvmlError("memory clock lock unsupported", NVML_ERROR_NOT_SUPPORTED)
        self._check(fn(self._handle, c_uint(int(mhz)), c_uint(int(mhz))))

    def reset_mem_clock(self):
        fn = getattr(self._lib, "nvmlDeviceResetMemoryLockedClocks", None)
        if fn is None:
            raise NvmlError("memory clock lock unsupported", NVML_ERROR_NOT_SUPPORTED)
        self._check(fn(self._handle))

    def has_mem_lock(self):
        """Whether this driver exposes the memory-clock lock API at all."""
        return getattr(self._lib, "nvmlDeviceSetMemoryLockedClocks", None) is not None


class _PynvmlBackend:
    """Uses python-nvidia-ml-py (pynvml) when importable."""

    def __init__(self):
        import pynvml  # noqa: F401 (imported for availability check)
        # Require the locked-clock API too; otherwise fall back to ctypes.
        for name in ("nvmlDeviceSetGpuLockedClocks", "nvmlDeviceResetGpuLockedClocks",
                     "nvmlDeviceGetMaxClockInfo"):
            if not hasattr(pynvml, name):
                raise ImportError(f"pynvml lacks {name}")
        self._p = pynvml
        self._handle = None

    def _code(self, exc):
        code = getattr(exc, "value", None)
        return code

    def open(self, bdf):
        self._p.nvmlInit()
        try:
            self._handle = self._p.nvmlDeviceGetHandleByPciBusId(bdf)
        except Exception:
            # Older pynvml exposes it as ...ByPciBusId only.
            self._handle = self._p.nvmlDeviceGetHandleByPciBusId(bdf)
        return self

    def close(self):
        try:
            self._p.nvmlShutdown()
        except Exception:
            pass

    def get_offset(self):
        return int(self._p.nvmlDeviceGetGpcClkVfOffset(self._handle))

    def set_offset(self, mhz):
        self._p.nvmlDeviceSetGpcClkVfOffset(self._handle, int(mhz))

    def get_util(self):
        return int(self._p.nvmlDeviceGetUtilizationRates(self._handle).gpu)

    def set_max_clock(self, mhz):
        self._p.nvmlDeviceSetGpuLockedClocks(self._handle, 0, int(mhz))

    def reset_max_clock(self):
        self._p.nvmlDeviceResetGpuLockedClocks(self._handle)

    def get_max_clock(self, clock_id=NVML_CLOCK_GRAPHICS):
        return int(self._p.nvmlDeviceGetMaxClockInfo(self._handle, clock_id))

    def get_mem_clocks(self):
        count = c_uint(0)
        # A NULL buffer is rejected with INSUFFICIENT_SIZE on some drivers but
        # still reports the count, so the first return value is ignored.
        self._p.nvmlDeviceGetSupportedMemoryClocks(self._handle, count, None)
        if not 0 < count.value < 4096:
            raise NvmlError("supported memory clocks unavailable", NVML_ERROR_NOT_SUPPORTED)
        buf = (c_uint * count.value)()
        self._p.nvmlDeviceGetSupportedMemoryClocks(self._handle, count, buf)
        return sorted({int(v) for v in buf if v})

    def set_mem_clock(self, mhz):
        self._p.nvmlDeviceSetMemoryLockedClocks(self._handle, int(mhz), int(mhz))

    def reset_mem_clock(self):
        self._p.nvmlDeviceResetMemoryLockedClocks(self._handle)

    def has_mem_lock(self):
        return hasattr(self._p, "nvmlDeviceSetMemoryLockedClocks")


def open_backend(bdf):
    """Open the best available NVML backend for `bdf`."""
    try:
        return _PynvmlBackend().open(bdf)
    except ImportError:
        pass
    except Exception:
        # pynvml present but failed; fall through to ctypes.
        pass
    return _CtypesBackend().open(bdf)


# ──────────────────────────────────────────────────────────────────────────────
# Command dispatch
# ──────────────────────────────────────────────────────────────────────────────

def _emit(obj, code=0):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()
    return code


def _error(exc):
    code = getattr(exc, "code", None)
    return _emit({"ok": False, "error": str(exc), "code": code})


def cmd_probe():
    bdf = find_nvidia_bdf()
    if bdf is None:
        return _emit({"ok": False, "supported": False, "error": "no NVIDIA dGPU found",
                      "helper_version": HELPER_VERSION})
    try:
        be = open_backend(bdf)
    except Exception as exc:  # noqa: BLE001
        return _emit({"ok": False, "supported": False, "device": bdf, "error": str(exc),
                      "code": getattr(exc, "code", None), "helper_version": HELPER_VERSION})
    try:
        try:
            offset = be.get_offset()
        except Exception as exc:  # noqa: BLE001
            return _emit({"ok": False, "supported": False, "device": bdf, "error": str(exc),
                          "code": getattr(exc, "code", None),
                          "helper_version": HELPER_VERSION})
        try:
            ceiling = be.get_max_clock()
        except Exception:
            ceiling = None
        mem_max = None
        try:
            mem_max = be.get_max_clock(NVML_CLOCK_MEM)
        except Exception:
            pass
        mem_clocks = None
        try:
            mem_clocks = be.get_mem_clocks()
        except Exception:
            pass
        return _emit({"ok": True, "supported": True, "device": bdf, "offset_mhz": offset,
                      "gpu_max_clock_mhz": ceiling, "mem_max_clock_mhz": mem_max,
                      "mem_supported_clocks": mem_clocks,
                      "mem_lock_api": bool(be.has_mem_lock()),
                      "helper_version": HELPER_VERSION})
    finally:
        be.close()


def cmd_get():
    bdf = find_nvidia_bdf()
    if bdf is None:
        return _emit({"ok": False, "error": "no NVIDIA dGPU found"})
    try:
        be = open_backend(bdf)
    except Exception as exc:  # noqa: BLE001
        return _error(exc)
    try:
        offset = be.get_offset()
        try:
            util = be.get_util()
        except Exception:
            util = None
        # Offset + utilisation only: utilisation is what the watcher uses to
        # decide when the dGPU has gone idle, and the offset is the applied V/F
        # value. No telemetry — see the module docstring.
        return _emit({"ok": True, "device": bdf, "offset_mhz": offset, "util": util})
    except Exception as exc:  # noqa: BLE001
        return _error(exc)
    finally:
        be.close()


def cmd_apply(mhz, maxmhz=0, memmhz=0):
    try:
        mhz = int(mhz)
        maxmhz = int(maxmhz)
        memmhz = int(memmhz)
    except (TypeError, ValueError):
        return _emit({"ok": False, "error": "invalid offset"}, code=2)
    mhz = max(0, min(MAX_OFFSET_MHZ, mhz))
    maxmhz = max(0, min(MAX_CLOCK_MHZ, maxmhz))
    memmhz = max(0, min(MAX_MEM_CLOCK_MHZ, memmhz))
    bdf = find_nvidia_bdf()
    if bdf is None:
        return _emit({"ok": False, "error": "no NVIDIA dGPU found"})
    try:
        be = open_backend(bdf)
    except Exception as exc:  # noqa: BLE001
        return _error(exc)
    try:
        be.set_offset(mhz)
        readback = be.get_offset()
        result = {"ok": True, "device": bdf, "offset_mhz": readback,
                  "max_clock_mhz": 0, "mem_clock_mhz": 0}
        # Each clock is independent: one unsupported lock must not undo the
        # others, so failures are reported per-control.
        try:
            if maxmhz > 0:
                be.set_max_clock(maxmhz)
                result["max_clock_mhz"] = maxmhz
            else:
                be.reset_max_clock()
        except Exception as exc:  # noqa: BLE001
            result["max_clock_error"] = str(exc)
        try:
            if memmhz > 0:
                be.set_mem_clock(memmhz)
                result["mem_clock_mhz"] = memmhz
            else:
                be.reset_mem_clock()
        except Exception as exc:  # noqa: BLE001
            result["mem_clock_error"] = str(exc)
        return _emit(result)
    except Exception as exc:  # noqa: BLE001
        return _error(exc)
    finally:
        be.close()


def main(argv):
    usage = ("usage: gigamate-dgpu-nvml "
             "{probe|get|apply <mhz> [maxmhz] [memmhz]|clear}")
    if len(argv) < 2:
        return _emit({"ok": False, "error": usage}, code=2)
    cmd = argv[1]
    if cmd == "probe":
        return cmd_probe()
    if cmd == "get":
        return cmd_get()
    if cmd == "apply":
        if len(argv) < 3:
            return _emit({"ok": False, "error": "apply requires <mhz> [maxmhz] [memmhz]"}, code=2)
        maxmhz = argv[3] if len(argv) > 3 else 0
        memmhz = argv[4] if len(argv) > 4 else 0
        return cmd_apply(argv[2], maxmhz, memmhz)
    if cmd == "clear":
        return cmd_apply(0, 0, 0)
    return _emit({"ok": False, "error": f"unknown command: {cmd}"}, code=2)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
