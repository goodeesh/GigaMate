# GigaMate — keyboard RGB and dGPU power access.
#
# Access is granted to the *active session user* via systemd-logind's
# "uaccess" tag (equivalent to an ACL for the logged-in seat) instead of
# world-writable 0666. This keeps no-root usage working without exposing the
# hardware to every local user/process.
#
# NOTE: this relies on systemd-logind (standard on Arch/Fedora/Debian/Ubuntu).
# On systems without logind, grant access via a dedicated group instead.

# Primary Gigabyte keyboard controller.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0414", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0414", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"

# Shared/generic USB vendors historically used by Gigabyte keyboards.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1044", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1044", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="04D9", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="04D9", ATTRS{idProduct}=="*", MODE="0660", TAG+="uaccess"

# AMD SmartShift bias control (active-session access only).
SUBSYSTEM=="pci", ATTRS{vendor}=="0x1002", ATTR{smartshift_bias}!="", MODE="0660", TAG+="uaccess"
